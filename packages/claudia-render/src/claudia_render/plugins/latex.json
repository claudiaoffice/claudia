{
  "api": 1,
  "type": "latex",
  "version": "1.0.0",
  "title": "LaTeX",
  "tier": "static",
  "requires": [{"tool": "xelatex"}, {"tool": "pdftocairo"}],
  "params": [
    {"name": "mode", "type": "string", "default": "math", "choices": ["math", "page"]},
    {"name": "width_mm", "type": "number", "default": 150, "minimum": 20, "maximum": 400}
  ],
  "adapter": "latex",
  "svg_elements": [],
  "limits": {"seconds": 20, "memory_mb": 2048, "output_mb": 16},
  "editor": {
    "syntax": "latex",
    "example": "\\int_0^1 x^2\\,dx = \\frac{1}{3}",
    "ai_hint": "mode=math: the text is a formula without dollar signs. mode=page: a block of text and formulas of the given width. No packages that read files or run programs."
  }
}
