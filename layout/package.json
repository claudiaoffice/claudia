{
  "name": "@claudia/layout",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic layout for claudia: fonts and shaping, paragraphs to lines, boxes, flow pagination, display lists and a PDF writer. Pure TypeScript (ES2022), no DOM, no Node API.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wasm/*": "./wasm/*"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "docs": "typedoc",
    "wasm": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "linebreak": "1.1.0",
    "harfbuzzjs": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "5.1.0",
    "pdfjs-dist": "4.10.38",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
