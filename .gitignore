# Python
.venv
*__pycache__*

# Documents and server state a local server writes: ./start.sh keeps them in .claudia/<app>/ (docs-<app>/ and
# demo-docs*/ are where earlier versions of it did; still ignored, so nobody commits a leftover by accident)
.claudia/
docs-*
demo-docs
demo-docs-*

# Generated documentation; docs/ itself is source and tracked
docs/_build

# Web app: build output and dependencies (web/dist was an early build target, CODE-02)
web/.nuxt
web/.output
web/dist
web/node_modules
web/coverage
# the HarfBuzz WebAssembly the build copies from harfbuzzjs (npm run build/dev, D903)
web/public/wasm

# The macOS and Windows client (D660): dependencies, build output, what `npm run build` generates per app, Neutralino's
# downloads, the .app bundle and the logs. (`clients/neutralino/bin/` -- the `claudia-<app>` commands -- is source.)
clients/neutralino/node_modules/
clients/neutralino/dist/
clients/neutralino/apps/*/bin/
clients/neutralino/apps/*/js/
clients/neutralino/apps/*/index.html
clients/neutralino/apps/*/shell/
clients/neutralino/apps/*/ext/
clients/neutralino/apps/*/.tmp/
clients/neutralino/apps/*/neutralinojs.log

# The test-document library's run output
test-documents/_artifacts

# Obsidian: the vault's settings and plugins are shared; each person's window layout is not
claudiaoffice-log/.obsidian/workspace*.json

# Patches handed around in chat, and macOS litter
*.patch
!packaging/macos/*.patch
# (the build applies those: they are sources, not deliveries)
*DS_Store*

# Coverage data the gate's `tests` step writes (CODE-01)
.coverage
.coverage.*

ai-models/*

Claude*

# What the installers build in a checkout (packaging/macos, spikes/e8-5-mac-launcher; on CI also packaging/windows)
/build/
