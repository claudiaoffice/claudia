{
  "name": "claudia-shell-macos",
  "private": true,
  "version": "0.2.0",
  "description": "The macOS client of Claudia: a thin Neutralino shell with a native core around the web frontend (E5.11, D42, D251).",
  "type": "module",
  "scripts": {
    "generate-menu": "python3 tools/generate_menu.py --all",
    "check-menu": "python3 tools/generate_menu.py --all --check",
    "build": "tsc -p tsconfig.json && node tools/build-shell.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start:composes": "node dist/launch.js composes",
    "start:computes": "node dist/launch.js computes",
    "start:creates": "node dist/launch.js creates"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.2"
  },
  "bin": {
    "claudia-composes": "bin/composes.mjs",
    "claudia-computes": "bin/computes.mjs",
    "claudia-creates": "bin/creates.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "apps",
    "tools"
  ]
}
