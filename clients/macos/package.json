{
  "name": "claudia-shell-macos",
  "private": true,
  "version": "0.1.0",
  "description": "The macOS client of Claudia: a thin Neutralino shell around the web frontend (E5.11, D42, D159).",
  "type": "module",
  "scripts": {
    "generate-menu": "python3 tools/generate_menu.py --all",
    "check-menu": "python3 tools/generate_menu.py --all --check",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start:creates": "node dist/launch.js creates"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
