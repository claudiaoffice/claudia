{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "de.claudiaoffice.creates",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": true, "writeToLogFile": true },
  "nativeAllowList": ["app.exit", "window.setMainMenu", "window.print", "events.on"],
  "modes": {
    "window": {
      "title": "Claudia Creates",
      "width": 1280,
      "height": 860,
      "minWidth": 700,
      "minHeight": 500,
      "center": true,
      "icon": "/icon.png",
      "enableInspector": false,
      "borderless": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "injectGlobals": true,
      "injectClientLibrary": true,
      "injectScript": "/inject/claudia-bridge.js"
    }
  },
  "cli": {
    "binaryName": "claudia-creates",
    "resourcesPath": "/",
    "clientLibrary": "/js/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}
