{
  "name": "claudia-shell-neutralino",
  "private": true,
  "version": "0.3.0",
  "description": "The macOS and Windows client of Claudia: a thin Neutralino shell with a native core around the web frontend (E5.11, D42, D251, D660).",
  "type": "module",
  "scripts": {
    "generate-menu": "uv run --no-project python tools/generate_menu.py --all",
    "check-menu": "uv run --no-project python tools/generate_menu.py --all --check",
    "build": "tsc -p tsconfig.json && node tools/build-shell.mjs",
    "build:macos": "tsc -p tsconfig.json && node tools/build-shell.mjs --platform macos",
    "build:windows": "tsc -p tsconfig.json && node tools/build-shell.mjs --platform windows",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start:composes": "node dist/launch.js composes",
    "start:computes": "node dist/launch.js computes",
    "start:creates": "node dist/launch.js creates"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "bin": {
    "claudia-composes": "bin/composes.mjs",
    "claudia-computes": "bin/computes.mjs",
    "claudia-creates": "bin/creates.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "apps",
    "tools"
  ]
}
