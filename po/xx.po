#: packages/claudia-computes/src/claudia_computes/functions
msgid "\"recalc\" (Automatic), \"numfile\" (the number of sheets), \"origin\" ($A:$A$1), \"system\" (claudia) and \"release\" (the version of the formula language). Others are #N/A."
msgstr "[\"récàlc\" (Àûtômàtîc), \"nûmfîlé\" (thé nûmbér ôf shééts), \"ôrîgîn\" ($À:$À$1), \"systém\" (clàûdîà) ànd \"réléàsé\" (thé vérsîôn ôf thé fôrmûlà làngûàgé). Ôthérs àré #N/À.~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~]"

