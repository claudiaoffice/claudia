#: packages/claudia-computes/src/claudia_computes/functions
msgid "\"address\" ($A$1), \"row\", \"col\", \"contents\", \"type\" (b blank, l text, v other), \"sheet\", and the plain defaults \"format\" (G), \"prefix\", \"protect\", \"parentheses\", \"color\" and \"filename\". Others (\"width\") are #N/A: claudia has no column widths a formula can see."
msgstr "\"address\" ($A$1), \"row\", \"col\", \"contents\", \"type\" (b leer, l Text, v anderes), \"sheet\" sowie die einfachen Vorgaben \"format\" (G), \"prefix\", \"protect\", \"parentheses\", \"color\" und \"filename\". Anderes (\"width\") ergibt #N/A: Spaltenbreiten sind für eine Formel nicht sichtbar."

#: packages/claudia-computes/src/claudia_computes/functions
msgid "\"recalc\" (Automatic), \"numfile\" (the number of sheets), \"origin\" ($A:$A$1), \"system\" (claudia) and \"release\" (the version of the formula language). Others are #N/A."
msgstr "\"recalc\" (Automatic), \"numfile\" (Anzahl der Tabellenblätter), \"origin\" ($A:$A$1), \"system\" (claudia) und \"release\" (Version der Formelsprache). Anderes ergibt #N/A."

