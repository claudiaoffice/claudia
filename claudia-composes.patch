+  display: grid;
+  gap: 8px;
+}
+li {
+  padding: 9px 10px;
+  border-radius: 9px;
+  background: rgb(231 225 244 / 8%);
+  border: 1px solid transparent;
+  cursor: pointer;
+}
+li.hot {
+  border-color: rgb(231 225 244 / 55%);
+}
+li.outdated {
+  opacity: 0.7;
+}
+p {
+  margin: 0;
+}
+.reason {
