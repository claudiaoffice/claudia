+  /** Let go of my zone (the person left the text). */
+  async release(): Promise<void> {
+    await this.flush()
+    this.placed = ''
+    try {
+      await this.need().request('unlock')
+    } catch {
+      /* the lock runs out by itself */
+    }
+  }
