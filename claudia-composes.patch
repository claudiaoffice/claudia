+++ b/packages/claudia-composes/src/claudia_composes/events.py
@@ -0,0 +1,83 @@
+"""State events the text model raises through ``Context.emit``: what a replica needs to follow the document.
+
+Each event describes one step on the text, so a client that holds the paragraphs applies it to what it has, and
+moves its own cursor through it, without asking for the document again.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .runs import Run, runs_to_data
+
+
+@dataclass(frozen=True)
+class TextChanged:
+    """``removed`` characters at ``offset`` of a paragraph were replaced by ``inserted``, written as ``runs``."""
+
+    block: str
+    offset: int
+    removed: int
+    inserted: str
+    runs: tuple[Run, ...] = ()
+
+    def to_data(self) -> dict:
+        """The plain-data form of the event, as sent to clients."""
+        return {
+            "type": "text",
+            "block": self.block,
+            "offset": self.offset,
+            "removed": self.removed,
+            "inserted": self.inserted,
+            "runs": runs_to_data(list(self.runs)),
+        }
+
+
+@dataclass(frozen=True)
+class BlockSplit:
+    """The paragraph ``block`` was cut at ``offset``; the rest is the new paragraph ``new_id``, right after it."""
+
+    block: str
+    offset: int
+    new_id: str
+    style: str
+
+    def to_data(self) -> dict:
+        """The plain-data form of the event, as sent to clients."""
+        return {"type": "split", "block": self.block, "offset": self.offset, "new_id": self.new_id, "style": self.style}
+
+
+@dataclass(frozen=True)
+class BlocksJoined:
+    """The paragraph ``block`` was put at the end of ``into``, whose text was ``at`` characters long."""
+
+    block: str
+    into: str
+    at: int
+
+    def to_data(self) -> dict:
+        """The plain-data form of the event, as sent to clients."""
+        return {"type": "join", "block": self.block, "into": self.into, "at": self.at}
+
+
+@dataclass(frozen=True)
+class StyleChanged:
+    """The paragraph ``block`` has another style."""
+
+    block: str
+    style: str
+
+    def to_data(self) -> dict:
+        """The plain-data form of the event, as sent to clients."""
+        return {"type": "style", "block": self.block, "style": self.style}
+
+
+@dataclass(frozen=True)
+class SuggestionsChanged:
+    """These suggestions are new or changed (state, place); a client replaces what it holds under their ids."""
+
+    items: tuple[dict, ...]
+
+    def to_data(self) -> dict:
+        """The plain-data form of the event, as sent to clients."""
+        return {"type": "suggestions", "items": list(self.items)}
diff --git a/packages/claudia-composes/src/claudia_composes/model.py b/packages/claudia-composes/src/claudia_composes/model.py
new file mode 100644
index 0000000..1bdfaa6
--- /dev/null
+++ b/packages/claudia-composes/src/claudia_composes/model.py
@@ -0,0 +1,288 @@
+"""The text model: named paragraphs, who wrote each stretch, and the AI's open suggestions (E9.1, D62, D63).
+
+A document is a list of paragraphs. Each has an id that is never reused, a style (by name: you mark text by what it is
+for, D62), its text and the runs that say who wrote what. Suggestions are proposals anchored to a stretch of text; they
+are state of the document like the paragraphs, but they change no text until somebody accepts them.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field, replace
+from typing import ClassVar, Self
+
+from claudia_core import CommandRegistry, DocumentModel, Region, new_registry
+
+from .region import TextRange
+from .runs import Run, delete_runs, insert_runs, runs_from_data, runs_to_data, slice_runs, total
+from .spans import TextCommand
+
+DEFAULT_STYLE = "body"
+FIRST_BLOCK = "b1"
+_NUMBERED = re.compile(r"[bs](\d+)")
+
+
+@dataclass(frozen=True)
+class Style:
+    """A named paragraph style: what the text is for, and which style follows when a writer ends such a paragraph."""
+
+    id: str
+    name: str
+    purpose: str
+    next: str
+
+
+STYLES: dict[str, Style] = {
+    s.id: s
+    for s in (
+        Style("body", "Body text", "running text", "body"),
+        Style("title", "Title", "names the document", "body"),
+        Style("heading-1", "Heading 1", "a section", "body"),
+        Style("heading-2", "Heading 2", "a subsection", "body"),
+        Style("quote", "Quote", "words of someone else", "body"),
+        Style("remark", "Remark", "a note to the reader or co-author", "body"),
+        Style("definition", "Definition", "says what a term means", "body"),
+    )
+}
+
+
+@dataclass
+class Block:
+    """One paragraph: ``runs`` always add up to the length of ``text``."""
+
+    id: str
+    style: str
+    text: str = ""
+    runs: list[Run] = field(default_factory=list)
+
+    def to_data(self) -> dict:
+        """The plain-data form: ``{id, style, text, runs}``."""
+        return {"id": self.id, "style": self.style, "text": self.text, "runs": runs_to_data(self.runs)}
+
+
+@dataclass(frozen=True)
+class Suggestion:
+    """A proposal: replace ``original`` (the text at ``anchor`` when it was made) by ``replacement``.
+
+    ``replacement`` is ``None`` for a remark, which suggests no change. ``state`` is ``open``, ``accepted``,
+    ``rejected``, ``dismissed`` (a remark) or ``withdrawn`` (the proposal was undone and does not exist any more)."""
+
+    id: str
+    author: str | None
+    anchor: TextRange
+    original: str
+    replacement: str | None
+    reason: str
+    state: str = "open"
+
+
+class TextModel(DocumentModel):
+    """The paragraphs of a document and its suggestions."""
+
+    app: ClassVar[str] = "composes"
+    state_schema: ClassVar[int] = 2
+    registry: ClassVar[CommandRegistry] = new_registry()
+    styles: ClassVar[dict[str, Style]] = STYLES
+
+    def __init__(self, blocks: list[Block] | None = None):
+        self.blocks: list[Block] = blocks if blocks is not None else [Block(FIRST_BLOCK, DEFAULT_STYLE)]
+        self.suggestions: dict[str, Suggestion] = {}
+        self._last = {"b": _highest(b.id for b in self.blocks), "s": 0}
+
+    # -- lifecycle ---------------------------------------------------------------
+    @classmethod
+    def empty(cls) -> Self:
+        """A document with one empty body paragraph."""
+        return cls()
+
+    def serialize(self) -> dict:
+        """The state as plain data (a snapshot is a cache of it)."""
+        return {
+            "blocks": [b.to_data() for b in self.blocks],
+            "suggestions": [self.suggestion_data(s, with_state=True) for s in self.suggestions.values()],
+            "last": dict(self._last),
+        }
+
+    @classmethod
+    def restore(cls, state: dict) -> Self:
+        """Build a model from ``serialize()``'s output; the older shape (a list of strings) is understood too."""
+        raw = state["blocks"]
+        if raw and isinstance(raw[0], str):  # state schema 1: the stub, which could not hold more than strings
+            blocks = [Block(f"b{i}", DEFAULT_STYLE, t, [Run(len(t), None)] if t else []) for i, t in enumerate(raw, 1)]
+            return cls(blocks)
+        model = cls([Block(b["id"], b["style"], b["text"], runs_from_data(b["runs"])) for b in raw])
+        for item in state.get("suggestions", []):
+            model.suggestions[item["id"]] = _suggestion_from_data(item)
+        model._last = dict(state.get("last", model._last))
+        return model
+
+    def region_from_data(self, data: dict) -> Region:
+        """Read a region a client sent: ``{"kind": "text", "block", "start", "end"}``."""
+        if data.get("kind") != TextRange.kind:
+            raise ValueError(f"composes knows only text regions, not {data.get('kind')!r}")
+        block, start, end = data["block"], data["start"], data["end"]
+        if not (isinstance(block, str) and isinstance(start, int) and isinstance(end, int) and 0 <= start <= end):
+            raise ValueError("a text region names a paragraph and 0 <= start <= end")
+        return TextRange(block, start, end)
+
+    # -- reading -----------------------------------------------------------------
+    def block(self, block_id: str) -> Block:
+        """The paragraph with this id; ``KeyError`` if there is none."""
+        for block in self.blocks:
+            if block.id == block_id:
+                return block
+        raise KeyError(f"no paragraph {block_id!r}")
+
+    def index_of(self, block_id: str) -> int:
+        """The place of the paragraph in the document; ``KeyError`` if there is none."""
+        self.block(block_id)
+        return next(i for i, b in enumerate(self.blocks) if b.id == block_id)
+
+    def fresh_ids(self, count: int) -> list[str]:
+        """``count`` ids for new paragraphs. Ids are never used twice, not even after a join, so undo can bring one
+        back."""
+        return [f"b{self._last['b'] + n}" for n in range(1, count + 1)]
+
+    def fresh_id(self) -> str:
+        """An id for a new paragraph (see ``fresh_ids``)."""
+        return self.fresh_ids(1)[0]
+
+    def fresh_suggestion_id(self) -> str:
+        """An id for a new suggestion."""
+        return f"s{self._last['s'] + 1}"
+
+    def suggestion(self, suggestion_id: str) -> Suggestion:
+        """The suggestion with this id; ``KeyError`` if there is none."""
+        try:
+            return self.suggestions[suggestion_id]
+        except KeyError:
+            raise KeyError(f"no suggestion {suggestion_id!r}") from None
+
+    def is_outdated(self, suggestion: Suggestion) -> bool:
+        """Has the text under a suggestion changed since it was made? It then cannot be accepted any more."""
+        a = suggestion.anchor
+        try:
+            current = self.block(a.block).text[a.start : a.end]
+        except KeyError:
+            return True
+        return current != suggestion.original
+
+    def suggestion_data(self, suggestion: Suggestion, *, with_state: bool = False) -> dict:
+        """A suggestion as sent to clients (``with_state`` also keeps the ones that are over, for snapshots)."""
+        a = suggestion.anchor
+        data = {
+            "id": suggestion.id,
+            "author": suggestion.author,
+            "block": a.block,
+            "start": a.start,
+            "end": a.end,
+            "original": suggestion.original,
+            "replacement": suggestion.replacement,
+            "reason": suggestion.reason,
+            "state": suggestion.state,
+        }
+        if not with_state:
+            data["outdated"] = self.is_outdated(suggestion)
+        return data
+
+    def visible_suggestions(self) -> list[dict]:
+        """The suggestions people may still act on, in the order they were made."""
+        return [self.suggestion_data(s) for s in self.suggestions.values() if s.state == "open"]
+
+    # -- changing text (used by the commands) ------------------------------------
+    def insert(self, block_id: str, offset: int, text: str, runs: list[Run]) -> None:
+        """Put ``text`` into a paragraph at ``offset``; ``runs`` say who wrote it."""
+        block = self.block(block_id)
+        if not 0 <= offset <= len(block.text):
+            raise IndexError("insert outside the text")
+        if total(runs) != len(text):
+            raise ValueError("the runs must cover exactly the inserted text")
+        block.text = block.text[:offset] + text + block.text[offset:]
+        block.runs = insert_runs(block.runs, offset, runs)
+
+    def remove(self, block_id: str, start: int, end: int) -> tuple[str, list[Run]]:
+        """Cut ``start <= i < end`` out of a paragraph; returns what was cut, with its runs."""
+        block = self.block(block_id)
+        if not 0 <= start <= end <= len(block.text):
+            raise IndexError("delete outside the text")
+        removed = block.text[start:end], slice_runs(block.runs, start, end)
+        block.text = block.text[:start] + block.text[end:]
+        block.runs = delete_runs(block.runs, start, end)
+        return removed
+
+    def split(self, block_id: str, offset: int, new_id: str, style: str) -> None:
+        """Cut a paragraph at ``offset``; the rest becomes the paragraph ``new_id`` right behind it."""
+        block = self.block(block_id)
+        if not 0 <= offset <= len(block.text):
+            raise IndexError("split outside the text")
+        if any(b.id == new_id for b in self.blocks):
+            raise ValueError(f"the paragraph {new_id!r} exists already")
+        self.check_style(style)
+        rest = Block(new_id, style, block.text[offset:], slice_runs(block.runs, offset, len(block.text)))
+        block.text, block.runs = block.text[:offset], slice_runs(block.runs, 0, offset)
+        self.blocks.insert(self.index_of(block_id) + 1, rest)
+        self._note_id(new_id)
+
+    def join(self, block_id: str, into: str, at: int) -> str:
+        """Put paragraph ``block_id`` at the end of ``into`` (the one right before it, ``at`` characters long).
+
+        Returns the style of the paragraph that went away."""
+        first, second = self.block(into), self.block(block_id)
+        if self.index_of(block_id) != self.index_of(into) + 1:
+            raise ValueError("a paragraph can only be joined to the one right before it")
+        if len(first.text) != at:
+            raise ValueError("the paragraph before it is not as long as the command says")
+        first.text += second.text
+        first.runs = insert_runs(first.runs, at, second.runs)
+        self.blocks.remove(second)
+        return second.style
+
+    def check_style(self, style: str) -> None:
+        """``ValueError`` unless the document has a style of this name."""
+        if style not in self.styles:
+            raise ValueError(f"no style {style!r}")
+
+    # -- suggestions (used by the commands) --------------------------------------
+    def add_suggestion(self, suggestion: Suggestion) -> None:
+        """Add a new suggestion."""
+        if suggestion.id in self.suggestions:
+            raise ValueError(f"the suggestion {suggestion.id!r} exists already")
+        a = suggestion.anchor
+        if not 0 <= a.start <= a.end <= len(self.block(a.block).text):
+            raise IndexError("a suggestion must lie inside the text")
+        self.suggestions[suggestion.id] = suggestion
+        self._note_id(suggestion.id)
+
+    def put_suggestion(self, suggestion: Suggestion) -> None:
+        """Replace a suggestion by a changed version of it."""
+        self.suggestions[suggestion.id] = suggestion
+
+    def move_suggestions(self, command: TextCommand) -> list[dict]:
+        """Let the open suggestions follow ``command``; returns the ones that moved, as sent to clients."""
+        moved = []
+        for suggestion in list(self.suggestions.values()):
+            if suggestion.state != "open":
+                continue
+            span = command.follow(suggestion.anchor.span)
+            if span != suggestion.anchor.span:
+                updated = replace(suggestion, anchor=TextRange(*span))
+                self.suggestions[suggestion.id] = updated
+                moved.append(self.suggestion_data(updated))
+        return moved
+
+    def _note_id(self, ident: str) -> None:
+        """Remember numbered ids that were used so that ``fresh_id`` never hands one out twice."""
+        found = _NUMBERED.fullmatch(ident)
+        if found:
+            self._last[ident[0]] = max(self._last[ident[0]], int(found.group(1)))
+
+
+def _highest(ids) -> int:
+    return max((int(m.group(1)) for i in ids if i.startswith("b") and (m := _NUMBERED.fullmatch(i))), default=0)
+
+
+def _suggestion_from_data(item: dict) -> Suggestion:
+    anchor = TextRange(item["block"], item["start"], item["end"])
+    return Suggestion(
+        item["id"], item["author"], anchor, item["original"], item["replacement"], item["reason"], item["state"]
+    )
diff --git a/packages/claudia-composes/src/claudia_composes/region.py b/packages/claudia-composes/src/claudia_composes/region.py
new file mode 100644
index 0000000..f87a25c
--- /dev/null
+++ b/packages/claudia-composes/src/claudia_composes/region.py
@@ -0,0 +1,71 @@
+"""The text region: a stretch of one paragraph, and the ± n words zone around a cursor (D11, D17)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import ClassVar
+
+from claudia_core import Command, Region
+
+from .spans import Span, TextCommand
+
+
+@dataclass(frozen=True)
+class TextRange:
+    """Characters ``start <= i < end`` of one paragraph: where a cursor and its protected zone are.
+
+    An empty range is a caret. It overlaps nothing, but it moves with the text and is drawn."""
+
+    kind: ClassVar[str] = "text"
+    block: str
+    start: int
+    end: int
+
+    @property
+    def span(self) -> Span:
+        """The range as a ``(block, start, end)`` triple."""
+        return (self.block, self.start, self.end)
+
+    def overlaps(self, other: Region) -> bool:
+        """Do the two ranges share a character?"""
+        return (
+            isinstance(other, TextRange)
+            and self.block == other.block
+            and self.start < self.end
+            and other.start < other.end
+            and self.start < other.end
+            and other.start < self.end
+        )
+
+    def transformed(self, command: Command) -> TextRange | None:
+        """The range after one leaf command; ``None`` if the text it covered is gone."""
+        if not isinstance(command, TextCommand):
+            return self
+        moved = TextRange(*command.follow(self.span))
+        was_text, is_gone = self.start < self.end, moved.end <= moved.start
+        return None if was_text and is_gone else moved
+
+    def to_data(self) -> dict:
+        """The plain-data form for the wire."""
+        return {"kind": self.kind, "block": self.block, "start": self.start, "end": self.end}
+
+
+_WORD = re.compile(r"\w+", re.UNICODE)
+
+
+def word_window(text: str, cursor: int, n: int, block: str = "b1") -> TextRange:
+    """The zone of D11: from ``n`` words before the cursor to ``n`` words after it.
+
+    A word is a run of letters or digits. A cursor inside a word protects that word whole."""
+    words = [(m.start(), m.end()) for m in _WORD.finditer(text)]
+    before = [w for w in words if w[1] <= cursor]
+    after = [w for w in words if w[0] >= cursor]
+    inside = [w for w in words if w[0] < cursor < w[1]]
+    start = (before[-n][0] if len(before) >= n else 0) if n else cursor
+    if inside:
+        start = min(start, inside[0][0])
+    end = (after[n - 1][1] if len(after) >= n else len(text)) if n else cursor
+    if inside:
+        end = max(end, inside[0][1])
+    return TextRange(block, start, end)
diff --git a/packages/claudia-composes/src/claudia_composes/runs.py b/packages/claudia-composes/src/claudia_composes/runs.py
new file mode 100644
index 0000000..cfba2cc
--- /dev/null
+++ b/packages/claudia-composes/src/claudia_composes/runs.py
@@ -0,0 +1,69 @@
+"""Authorship runs: who wrote which stretch of a paragraph (E9.10, D63).
+
+A paragraph's text comes with a list of runs that together are exactly as long as the text. A run names the person
+who wrote it and, when the text came in by accepting a suggestion, whose suggestion it was (``via``). The runs are
+part of the state the commands maintain, so they are rebuilt by replaying the log and nothing else is stored.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Run:
+    """``length`` characters written by ``author`` (``None``: unknown), through ``via``'s suggestion if any."""
+
+    length: int
+    author: str | None
+    via: str | None = None
+
+
+def total(runs: list[Run]) -> int:
+    """The number of characters the runs cover."""
+    return sum(run.length for run in runs)
+
+
+def normalized(runs: list[Run]) -> list[Run]:
+    """The runs without empty ones, with neighbours of the same origin joined."""
+    out: list[Run] = []
+    for run in runs:
+        if run.length <= 0:
+            continue
+        if out and (out[-1].author, out[-1].via) == (run.author, run.via):
+            out[-1] = Run(out[-1].length + run.length, run.author, run.via)
+        else:
+            out.append(run)
+    return out
+
+
+def slice_runs(runs: list[Run], start: int, end: int) -> list[Run]:
+    """The part of the runs from ``start`` up to ``end``."""
+    out: list[Run] = []
+    position = 0
+    for run in runs:
+        lo, hi = max(start, position), min(end, position + run.length)
+        if lo < hi:
+            out.append(Run(hi - lo, run.author, run.via))
+        position += run.length
+    return normalized(out)
+
+
+def delete_runs(runs: list[Run], start: int, end: int) -> list[Run]:
+    """The runs without the characters from ``start`` up to ``end``."""
+    return normalized([*slice_runs(runs, 0, start), *slice_runs(runs, end, total(runs))])
+
+
+def insert_runs(runs: list[Run], offset: int, new: list[Run]) -> list[Run]:
+    """The runs with ``new`` put in at ``offset``."""
+    return normalized([*slice_runs(runs, 0, offset), *new, *slice_runs(runs, offset, total(runs))])
+
+
+def runs_to_data(runs: list[Run]) -> list[list]:
+    """The plain-data form: ``[[length, author, via], ...]``."""
+    return [[run.length, run.author, run.via] for run in runs]
+
+
+def runs_from_data(data: list[list]) -> list[Run]:
+    """Inverse of ``runs_to_data``."""
+    return [Run(length, author, via) for length, author, via in data]
diff --git a/packages/claudia-composes/src/claudia_composes/spans.py b/packages/claudia-composes/src/claudia_composes/spans.py
new file mode 100644
index 0000000..bf7a01f
--- /dev/null
+++ b/packages/claudia-composes/src/claudia_composes/spans.py
@@ -0,0 +1,29 @@
+"""Where a stretch of text goes when other commands run (E1.5, E1.4).
+
+A *span* is ``(block, start, end)``: characters ``start <= i < end`` of one paragraph; a caret is an empty span.
+Cursors, zones, suggestions and the commands that undo old steps all hold spans, and all of them have to follow
+edits made by somebody else. The rule for each command lives with the command (``TextCommand.follow``); regions,
+suggestions and ``shifted_by`` only ask.
+"""
+
+from __future__ import annotations
+
+from abc import ABC
+
+from claudia_core import Command
+
+Span = tuple[str, int, int]
+
+
+class TextCommand(Command, ABC):
+    """A command that changes the text or its paragraphs and therefore moves spans."""
+
+    def follow(self, span: Span) -> Span:
+        """Where ``span`` is after this command ran. Never fails: a stretch that was cut away becomes empty."""
+        return span
+
+    def breaks(self, span: Span) -> bool:
+        """Does this command make ``span`` meaningless for undoing a step that was written for it?
+
+        A colleague typing inside a passage, deleting part of it or splitting it in two does."""
+        return False
