+++ b/packages/claudia-composes/tests/test_runs.py
@@ -0,0 +1,46 @@
+"""Authorship runs: who wrote which stretch of a paragraph, and how that survives editing."""
+
+from claudia_composes.runs import Run, delete_runs, insert_runs, runs_from_data, runs_to_data, slice_runs, total
+
+
+def runs(*items):
+    return [Run(n, who, via) for n, who, via in items]
+
+
+def test_adjacent_runs_by_the_same_person_are_one_run():
+    merged = insert_runs(runs((3, "ann", None)), 3, runs((2, "ann", None)))
+    assert merged == runs((5, "ann", None))
+
+
+def test_the_same_person_through_a_suggestion_is_another_run():
+    merged = insert_runs(runs((3, "ann", None)), 3, runs((2, "ann", "ai")))
+    assert merged == runs((3, "ann", None), (2, "ann", "ai"))
+
+
+def test_inserting_inside_a_run_splits_it():
+    result = insert_runs(runs((6, "ann", None)), 2, runs((3, "ben", None)))
+    assert result == runs((2, "ann", None), (3, "ben", None), (4, "ann", None))
+
+
+def test_inserting_at_the_ends():
+    assert insert_runs(runs((2, "ann", None)), 0, runs((1, "ben", None))) == runs((1, "ben", None), (2, "ann", None))
+    assert insert_runs([], 0, runs((4, "ben", None))) == runs((4, "ben", None))
+
+
+def test_deleting_removes_exactly_that_part():
+    original = runs((3, "ann", None), (3, "ben", None), (3, "ann", None))
+    result = delete_runs(original, 2, 7)
+    assert total(result) == 4
+    assert result == runs((4, "ann", None))  # ann's two pieces meet and merge
+
+
+def test_a_slice_keeps_who_wrote_what():
+    original = runs((3, "ann", None), (3, "ben", None))
+    assert slice_runs(original, 2, 5) == runs((1, "ann", None), (2, "ben", None))
+    assert slice_runs(original, 0, 0) == []
+
+
+def test_runs_survive_a_round_trip_through_data():
+    original = runs((3, "ann", None), (2, "ben", "ai"))
+    assert runs_to_data(original) == [[3, "ann", None], [2, "ben", "ai"]]
+    assert runs_from_data(runs_to_data(original)) == original
diff --git a/packages/claudia-composes/tests/test_suggestions.py b/packages/claudia-composes/tests/test_suggestions.py
new file mode 100644
index 0000000..5c9a863
--- /dev/null
+++ b/packages/claudia-composes/tests/test_suggestions.py
@@ -0,0 +1,216 @@
+"""AI suggestions (D63, E9.9): proposals anchored to text. They change nothing until a person accepts one."""
+
+import pytest
+from composes_helpers import SENTENCE, text_of
+
+from claudia_composes import (
+    AcceptSuggestion,
+    DeleteText,
+    InsertText,
+    JoinBlocks,
+    ProposeSuggestion,
+    ResolveSuggestion,
+    SplitBlock,
+    TextModel,
+    TextRange,
+)
+from claudia_core import CommandLog, Document, RegionHeld
+
+QUICK = SENTENCE.index("quick")
+
+
+def propose(doc, sid="s1", start=QUICK, end=QUICK + 5, replacement="fast", *, reason="shorter", author="ai"):
+    original = text_of(doc)[start:end]
+    doc.execute(ProposeSuggestion(sid, "b1", start, end, original, replacement, reason), author=author)
+
+
+def accept(doc, sid="s1", who="ann"):
+    s = doc.model.suggestion(sid)
+    a = s.anchor
+    return doc.execute(AcceptSuggestion(sid, a.block, a.start, a.end, s.replacement, s.author), author=who)
+
+
+def runs(doc):
+    return [(r.length, r.author, r.via) for r in doc.model.block("b1").runs]
+
+
+def test_a_suggestion_changes_no_text(doc):
+    propose(doc)
+    assert text_of(doc) == SENTENCE
+    (item,) = doc.model.visible_suggestions()
+    assert (item["author"], item["original"], item["replacement"], item["outdated"]) == ("ai", "quick", "fast", False)
+
+
+def test_a_suggestion_is_not_blocked_by_somebodys_zone(doc):
+    doc.lock("ben", [TextRange("b1", 0, 20)], ttl=5)
+    propose(doc)  # it touches no text, so no lock applies to it
+    assert len(doc.model.visible_suggestions()) == 1
+
+
+def test_accepting_is_an_edit_by_the_accepter_and_records_whose_suggestion_it_was(doc):
+    propose(doc)
+    accept(doc, who="ben")
+    assert text_of(doc) == SENTENCE.replace("quick", "fast")
+    assert (runs(doc)[1][0], text_of(doc)[4:8]) == (4, "fast")
+    assert runs(doc)[1] == (4, "ben", "ai")
+    assert doc.model.suggestion("s1").state == "accepted" and doc.model.visible_suggestions() == []
+    assert doc.log.get(doc.revision).author == "ben"
+
+
+def test_the_history_names_both_people(doc):
+    propose(doc)
+    accept(doc, who="ben")
+    assert doc.log.get(doc.revision).command.summary == "accepted a suggestion by ai: “fast”"
+
+
+def test_undoing_an_accept_gives_the_text_and_the_suggestion_back(doc):
+    propose(doc)
+    accept(doc, who="ben")
+    doc.undo("ben")
+    assert text_of(doc) == SENTENCE
+    assert runs(doc) == [(len(SENTENCE), "ann", None)]
+    (item,) = doc.model.visible_suggestions()
+    assert (item["state"], item["outdated"], item["start"], item["end"]) == ("open", False, QUICK, QUICK + 5)
+    doc.redo("ben")
+    assert text_of(doc) == SENTENCE.replace("quick", "fast") and runs(doc)[1] == (4, "ben", "ai")
+
+
+def test_accepting_inside_somebodys_zone_is_refused_like_any_edit(doc):
+    propose(doc)
+    doc.lock("ben", [TextRange("b1", QUICK - 2, QUICK + 2)], ttl=5)
+    with pytest.raises(RegionHeld):
+        accept(doc, who="ann")
+    assert text_of(doc) == SENTENCE
+
+
+def test_a_deletion_is_a_suggestion_with_an_empty_replacement(doc):
+    propose(doc, start=3, end=9, replacement="")
+    accept(doc)
+    assert text_of(doc) == SENTENCE[:3] + SENTENCE[9:]
+
+
+def test_rejecting_is_logged_and_keeps_the_text(doc):
+    propose(doc)
+    doc.execute(ResolveSuggestion("s1", "rejected"), author="ann")
+    assert doc.model.visible_suggestions() == [] and text_of(doc) == SENTENCE
+    assert doc.log.get(doc.revision).command.summary == "rejected a suggestion"
+
+
+def test_a_remark_can_be_dismissed_but_not_accepted(doc):
+    doc.execute(ProposeSuggestion("s1", "b1", 0, 9, "the quick", None, "long sentence"), author="ai")
+    with pytest.raises(ValueError):
+        doc.execute(AcceptSuggestion("s1", "b1", 0, 9, "x", "ai"), author="ann")
+    doc.execute(ResolveSuggestion("s1", "dismissed"), author="ann")
+    assert doc.model.visible_suggestions() == []
+
+
+def test_a_suggestion_follows_text_typed_before_it(doc):
+    propose(doc)
+    doc.execute(InsertText("b1", 0, "Look: "), author="ben")
+    (item,) = doc.model.visible_suggestions()
+    assert (item["start"], item["outdated"]) == (QUICK + 6, False)
+    accept(doc)
+    assert text_of(doc).startswith("Look: the fast")
+
+
+def test_a_suggestion_is_outdated_when_its_text_changed_and_then_cannot_be_accepted(doc):
+    propose(doc)
+    doc.execute(InsertText("b1", QUICK + 2, "X"), author="ben")  # inside "quick"
+    (item,) = doc.model.visible_suggestions()
+    assert item["outdated"] is True
+    with pytest.raises(ValueError):
+        accept(doc)
+    assert "fast" not in text_of(doc)
+
+
+def test_a_suggestion_becomes_valid_again_if_the_change_is_undone(doc):
+    propose(doc)
+    doc.execute(InsertText("b1", QUICK + 2, "X"), author="ben")
+    doc.undo("ben")
+    assert doc.model.visible_suggestions()[0]["outdated"] is False
+
+
+def test_a_suggestion_whose_text_was_deleted_is_outdated(doc):
+    propose(doc)
+    doc.execute(DeleteText("b1", QUICK - 1, 8), author="ben")
+    assert doc.model.visible_suggestions()[0]["outdated"] is True
+
+
+def test_suggestions_move_with_a_split_and_a_join(doc):
+    propose(doc, "s1", SENTENCE.index("lazy"), SENTENCE.index("lazy") + 4, "idle")
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ben")
+    (item,) = doc.model.visible_suggestions()
+    assert (item["block"], item["start"], item["outdated"]) == ("b2", SENTENCE.index("lazy") - 9, False)
+    doc.execute(JoinBlocks("b2", "b1", 9), author="ben")
+    (item,) = doc.model.visible_suggestions()
+    assert (item["block"], item["start"], item["outdated"]) == ("b1", SENTENCE.index("lazy"), False)
+
+
+def test_a_split_through_the_suggested_text_makes_it_outdated(doc):
+    propose(doc)
+    doc.execute(SplitBlock("b1", QUICK + 2, "b2", "body"), author="ben")
+    assert doc.model.visible_suggestions()[0]["outdated"] is True
+
+
+def test_two_suggestions_on_overlapping_text_each_work_until_the_other_is_taken(doc):
+    propose(doc, "s1", QUICK, QUICK + 5, "fast")
+    propose(doc, "s2", QUICK - 4, QUICK + 5, "a swift", reason="plainer")  # "the quick"
+    accept(doc, "s2")
+    assert text_of(doc).startswith("a swift brown")
+    assert doc.model.suggestion("s1").state == "open"
+    assert doc.model.is_outdated(doc.model.suggestion("s1")), "its text is gone"
+    with pytest.raises(ValueError):
+        accept(doc, "s1")
+
+
+def test_the_command_must_say_what_the_suggestion_says(doc):
+    propose(doc)
+    with pytest.raises(ValueError):
+        doc.execute(AcceptSuggestion("s1", "b1", QUICK, QUICK + 5, "slow", "ai"), author="ann")
+    with pytest.raises(KeyError):
+        doc.execute(AcceptSuggestion("s9", "b1", QUICK, QUICK + 5, "fast", "ai"), author="ann")
+
+
+def test_a_suggestion_must_lie_inside_the_text_and_have_a_new_id(doc):
+    with pytest.raises(IndexError):
+        doc.execute(ProposeSuggestion("s1", "b1", 40, 90, "x", "y", "r"), author="ai")
+    propose(doc)
+    with pytest.raises(ValueError):
+        propose(doc)
+
+
+def test_a_rejection_can_be_undone(doc):
+    propose(doc)
+    doc.execute(ResolveSuggestion("s1", "rejected"), author="ann")
+    doc.undo("ann")
+    assert len(doc.model.visible_suggestions()) == 1
+
+
+def test_proposing_is_nobodys_undo_step(doc):
+    propose(doc)
+    assert doc.history_for("ai").can_undo is False
+
+
+def test_replay_and_snapshots_keep_suggestions(doc):
+    propose(doc)
+    propose(doc, "s2", 0, 3, "a")
+    accept(doc, "s2")
+    again = Document.open(TextModel, CommandLog.from_data(doc.log.to_data(), TextModel.registry))
+    assert again.model.serialize() == doc.model.serialize()
+    assert TextModel.restore(doc.model.serialize()).serialize() == doc.model.serialize()
+    assert doc.model.fresh_suggestion_id() == "s3"
+
+
+def test_a_suggestion_that_was_taken_back_by_the_log_is_not_listed(doc):
+    propose(doc)
+    inverse = doc.log.get(doc.revision).command
+    from claudia_core import Context
+
+    ResolveSuggestion("s1", "withdrawn").apply(Context(doc.model))
+    assert doc.model.visible_suggestions() == [] and inverse.kind == "composes.ProposeSuggestion"
+
+
+def test_the_ids_of_the_two_kinds_are_counted_apart(doc):
+    propose(doc, "s5")
+    doc.execute(SplitBlock("b1", 3, "b2", "body"), author="ann")
+    assert (doc.model.fresh_id(), doc.model.fresh_suggestion_id()) == ("b3", "s6")
diff --git a/packages/claudia-composes/tests/test_text_commands.py b/packages/claudia-composes/tests/test_text_commands.py
new file mode 100644
index 0000000..59538c5
--- /dev/null
+++ b/packages/claudia-composes/tests/test_text_commands.py
@@ -0,0 +1,201 @@
+"""The commands of the text model: typing, structure, styles, authorship, undo with colleagues."""
+
+import pytest
+from composes_helpers import SENTENCE, text_of, texts
+
+from claudia_composes import (
+    DeleteText,
+    InsertText,
+    JoinBlocks,
+    SetStyle,
+    SplitBlock,
+    TextModel,
+)
+from claudia_composes.runs import Run
+from claudia_core import Batch, CommandLog, Document, UndoConflict
+
+
+def authors(doc, block="b1"):
+    return [(r.length, r.author, r.via) for r in doc.model.block(block).runs]
+
+
+# ----------------------------------------------------------------------------- typing
+def test_a_new_document_has_one_empty_body_paragraph():
+    model = TextModel.empty()
+    assert [(b.id, b.style, b.text) for b in model.blocks] == [("b1", "body", "")]
+
+
+def test_typing_and_undo(doc):
+    doc.execute(InsertText("b1", 4, "very "), author="ben")
+    assert text_of(doc).startswith("the very quick")
+    doc.undo("ben")
+    assert text_of(doc) == SENTENCE
+
+
+def test_typing_outside_the_paragraph_is_refused_and_changes_nothing(doc):
+    for bad in (InsertText("b1", 999, "x"), InsertText("nope", 0, "x"), DeleteText("b1", 40, 10)):
+        with pytest.raises((IndexError, KeyError)):
+            doc.execute(bad, author="ben")
+    assert text_of(doc) == SENTENCE
+
+
+def test_what_was_typed_is_credited_to_whoever_typed_it(doc):
+    doc.execute(InsertText("b1", 4, "very "), author="ben")
+    assert authors(doc) == [(4, "ann", None), (5, "ben", None), (39, "ann", None)]
+
+
+def test_deleting_and_undoing_gives_the_text_back_to_its_author(doc):
+    doc.execute(InsertText("b1", 4, "very "), author="ben")
+    doc.execute(DeleteText("b1", 4, 5), author="ann")  # ann deletes ben's word
+    assert authors(doc) == [(len(SENTENCE), "ann", None)]
+    doc.undo("ann")
+    assert authors(doc) == [(4, "ann", None), (5, "ben", None), (39, "ann", None)]
+
+
+# ----------------------------------------------------------------------------- structure
+def test_splitting_makes_a_new_paragraph_with_the_rest_and_the_chosen_style(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "quote"), author="ann")
+    assert texts(doc) == ["the quick", " brown fox jumps over the lazy dog"]
+    assert [b.style for b in doc.model.blocks] == ["body", "quote"]
+    assert authors(doc, "b2") == [(len(SENTENCE) - 9, "ann", None)]
+
+
+def test_undoing_a_split_joins_the_paragraphs_again(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ann")
+    doc.undo("ann")
+    assert texts(doc) == [SENTENCE]
+    doc.redo("ann")
+    assert texts(doc) == ["the quick", " brown fox jumps over the lazy dog"]
+
+
+def test_joining_puts_the_second_paragraph_at_the_end_of_the_first_and_undo_splits_it(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "heading-1"), author="ann")
+    doc.execute(JoinBlocks("b2", "b1", 9), author="ben")
+    assert texts(doc) == [SENTENCE]
+    assert doc.model.block("b1").style == "body", "the first paragraph keeps its style"
+    doc.undo("ben")
+    assert [(b.id, b.style) for b in doc.model.blocks] == [("b1", "body"), ("b2", "heading-1")]
+
+
+def test_a_join_must_name_the_paragraph_before_and_where_it_ends(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ann")
+    for bad in (JoinBlocks("b2", "b1", 3), JoinBlocks("b1", "b2", 0), JoinBlocks("b9", "b1", 9)):
+        with pytest.raises((ValueError, KeyError)):
+            doc.execute(bad, author="ann")
+    assert len(doc.model.blocks) == 2
+
+
+def test_new_paragraph_ids_must_be_new_and_the_style_known(doc):
+    with pytest.raises(ValueError):
+        doc.execute(SplitBlock("b1", 3, "b1", "body"), author="ann")
+    with pytest.raises(ValueError):
+        doc.execute(SplitBlock("b1", 3, "b2", "no-such-style"), author="ann")
+
+
+def test_fresh_ids_are_never_reused_even_after_a_join(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ann")
+    doc.execute(JoinBlocks("b2", "b1", 9), author="ann")
+    assert doc.model.fresh_id() == "b3"
+
+
+# ----------------------------------------------------------------------------- styles
+def test_setting_a_style_and_undoing_it(doc):
+    doc.execute(SetStyle("b1", "heading-1"), author="ann")
+    assert doc.model.block("b1").style == "heading-1"
+    doc.undo("ann")
+    assert doc.model.block("b1").style == "body"
+
+
+def test_an_unknown_style_is_refused(doc):
+    with pytest.raises(ValueError):
+        doc.execute(SetStyle("b1", "sparkly"), author="ann")
+
+
+def test_every_style_says_what_it_is_for_and_what_follows_it():
+    styles = TextModel.styles
+    assert styles["heading-1"].next == "body" and styles["quote"].purpose
+    assert all(style.name and style.purpose and style.next in styles for style in styles.values())
+
+
+# ----------------------------------------------------------------------------- history sentences
+def test_the_history_reads_as_sentences(doc):
+    doc.execute(InsertText("b1", 0, "Hello "), author="ben")
+    doc.execute(SplitBlock("b1", 6, "b2", "body"), author="ben")
+    doc.execute(SetStyle("b2", "heading-1"), author="ben")
+    sentences = [entry.command.summary for entry in doc.log.path(doc.revision)]
+    assert sentences[-3:] == ["typed “Hello ”", "new paragraph", "style Heading 1"]
+
+
+# ----------------------------------------------------------------------------- undo with colleagues (E1.4)
+def test_undo_follows_text_typed_before_it_and_refuses_when_text_is_inside(doc):
+    doc.execute(InsertText("b1", 10, "SLOW "), author="ann")
+    doc.execute(InsertText("b1", 0, ">> "), author="ben")
+    doc.undo("ann")
+    assert "SLOW" not in text_of(doc) and text_of(doc).startswith(">> the quick")
+    doc.execute(InsertText("b1", 10, "ABCDEF"), author="ann")
+    doc.execute(InsertText("b1", 13, "xyz"), author="ben")  # inside ann's passage
+    with pytest.raises(UndoConflict):
+        doc.undo("ann")
+
+
+def test_undo_follows_a_colleague_who_split_the_paragraph_before_it(doc):
+    doc.execute(InsertText("b1", 40, "!!"), author="ann")
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ben")
+    doc.undo("ann")  # the exclamation marks are now in b2
+    assert text_of(doc, "b2").endswith("lazy dog") and "!" not in "".join(texts(doc))
+
+
+def test_undo_refuses_when_a_colleague_split_the_passage_in_two(doc):
+    doc.execute(InsertText("b1", 4, "ABCDEF"), author="ann")
+    doc.execute(SplitBlock("b1", 7, "b2", "body"), author="ben")
+    with pytest.raises(UndoConflict):
+        doc.undo("ann")
+
+
+def test_undo_follows_a_colleague_who_joined_paragraphs(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "body"), author="ann")
+    doc.execute(InsertText("b2", 1, "XX"), author="ann")
+    doc.execute(JoinBlocks("b2", "b1", 9), author="ben")
+    doc.undo("ann")  # her XX now sits at offset 10 of b1
+    assert "XX" not in text_of(doc)
+
+
+# ----------------------------------------------------------------------------- replay and redaction
+def test_replay_gives_the_same_text_runs_and_styles(doc):
+    doc.execute(InsertText("b1", 4, "very "), author="ben")
+    doc.execute(SplitBlock("b1", 12, "b2", "quote"), author="ben")
+    doc.execute(SetStyle("b1", "title"), author="ann")
+    again = Document.open(TextModel, CommandLog.from_data(doc.log.to_data(), TextModel.registry))
+    assert again.model.serialize() == doc.model.serialize()
+
+
+def test_a_snapshot_restores_the_same_state(doc):
+    doc.execute(SplitBlock("b1", 9, "b2", "quote"), author="ben")
+    restored = TextModel.restore(doc.model.serialize())
+    assert restored.serialize() == doc.model.serialize()
+    assert restored.fresh_id() == "b3"
+
+
+def test_redaction_blanks_what_was_typed_but_keeps_the_lengths(doc):
+    from claudia_core import Revision
+
+    doc.execute(InsertText("b1", 0, "SECRET "), author="ben")
+    doc.redact([Revision("main", 2)])
+    assert "SECRET" not in text_of(doc)
+    again = Document.open(TextModel, CommandLog.from_data(doc.log.to_data(), TextModel.registry))
+    assert again.model.serialize() == doc.model.serialize()
+
+
+# ----------------------------------------------------------------------------- one undo step
+def test_a_batch_is_one_undo_step(doc):
+    doc.execute(Batch((DeleteText("b1", 0, 4), InsertText("b1", 0, "a "))), author="ben")
+    assert text_of(doc).startswith("a quick")
+    doc.undo("ben")
+    assert text_of(doc) == SENTENCE
+
+
+def test_inserted_runs_can_be_given_explicitly(doc):
+    doc.execute(InsertText("b1", 0, "xy", by=(Run(1, "eve", None), Run(1, "ann", "ai"))), author="ben")
+    assert authors(doc)[:2] == [(1, "eve", None), (1, "ann", "ai")]
+    with pytest.raises(ValueError):
+        doc.execute(InsertText("b1", 0, "xy", by=(Run(5, "eve", None),)), author="ben")
