diff --git a/web/app/components/AcceptOwnershipDialog.vue b/web/app/components/AcceptOwnershipDialog.vue
new file mode 100644
index 0000000..f129dfb
--- /dev/null
+++ b/web/app/components/AcceptOwnershipDialog.vue
@@ -0,0 +1,54 @@
+<script setup lang="ts">
+// File ▸ Manage ▸ Accept ownership… (D135): the other half of Assign new owner…. Whoever was asked to take over a
+// document comes here and confirms it is them with their own password; there is no notification yet (the decision
+// log says so) — the two people tell each other, the same way they would hand over a key.
+import { ref } from 'vue'
+import type { BaseSession } from '~/lib/base-session'
+
+const props = defineProps<{ session: BaseSession }>()
+const emit = defineEmits<{ close: [] }>()
+
+const password = ref('')
+const busy = ref(false)
+const accepted = ref(false)
+
+async function accept() {
+  busy.value = true
+  if (await props.session.acceptOwner(password.value)) accepted.value = true
+  busy.value = false
+}
+</script>
+
+<template>
+  <Modal title="Accept ownership" @close="emit('close')">
+    <p v-if="accepted" class="lead">You are now the owner of <b>{{ session.state.doc }}</b>.</p>
+    <template v-else>
+      <p class="lead">If somebody asked you to take over <b>{{ session.state.doc }}</b>, confirm it is you with your own current password.</p>
+      <form class="form" @submit.prevent="accept">
+        <label class="field">Your password<input v-model="password" type="password" autocomplete="current-password" /></label>
+        <div class="buttons">
+          <button class="btn primary" type="submit" :disabled="busy || !password">Accept</button>
+          <button class="btn" type="button" @click="emit('close')">Cancel</button>
+        </div>
+      </form>
+    </template>
+    <div v-if="accepted" class="buttons">
+      <button class="btn primary" type="button" @click="emit('close')">Done</button>
+    </div>
+  </Modal>
+</template>
+
+<style scoped>
+.lead {
+  margin: 0;
+  color: var(--muted);
+}
+.form {
+  display: grid;
+  gap: 12px;
+}
+.buttons {
+  display: flex;
+  gap: 10px;
+}
+</style>
diff --git a/web/app/components/AssignOwnerDialog.vue b/web/app/components/AssignOwnerDialog.vue
new file mode 100644
index 0000000..7d0906c
--- /dev/null
+++ b/web/app/components/AssignOwnerDialog.vue
@@ -0,0 +1,78 @@
+<script setup lang="ts">
+// File ▸ Manage ▸ Assign new owner… (D135). A role lives inside its own password-sealed slot (D102), so handing
+// one over is a propose/accept pair: we prove it is us with our own password now, and the person we pick proves it
+// is them with theirs when they accept (elsewhere, the next time they open this menu and see the offer — there is
+// no separate "accept" screen yet; see the decision log).
+import { onMounted, ref } from 'vue'
+import type { BaseSession } from '~/lib/base-session'
+
+const props = defineProps<{ session: BaseSession }>()
+const emit = defineEmits<{ close: [] }>()
+
+const editors = ref<string[]>([])
+const loaded = ref(false)
+const chosen = ref('')
+const password = ref('')
+const busy = ref(false)
+const proposed = ref<string | null>(null)
+
+onMounted(async () => {
+  const roster = await props.session.roster()
+  if (roster !== false) editors.value = roster.filter((p) => p.role === 'editor').map((p) => p.user)
+  loaded.value = true
+})
+
+async function propose() {
+  busy.value = true
+  if (await props.session.proposeOwner(chosen.value, password.value)) proposed.value = chosen.value
+  busy.value = false
+}
+</script>
+
+<template>
+  <Modal title="Assign a new owner" @close="emit('close')">
+    <p v-if="proposed" class="lead">
+      <b>{{ proposed }}</b> has been asked to take over <b>{{ session.state.doc }}</b>. Until they accept, you are still the owner. You will become an
+      editor the moment they do.
+    </p>
+    <template v-else>
+      <p class="lead">
+        Hand <b>{{ session.state.doc }}</b> over to somebody who already edits it. You will become an editor; they become the owner once they accept —
+        confirm it is you with your own password.
+      </p>
+      <form v-if="loaded" class="form" @submit.prevent="propose">
+        <label v-if="editors.length" class="field"
+          >New owner
+          <select v-model="chosen">
+            <option value="" disabled>Choose somebody…</option>
+            <option v-for="name in editors" :key="name" :value="name">{{ name }}</option>
+          </select>
+        </label>
+        <p v-else class="lead">Nobody edits this document yet. Make somebody an editor first (File ▸ Manage ▸ Share…).</p>
+        <label v-if="editors.length" class="field">Your password<input v-model="password" type="password" autocomplete="current-password" /></label>
+        <div class="buttons">
+          <button v-if="editors.length" class="btn primary" type="submit" :disabled="busy || !chosen || !password">Ask them to take over</button>
+          <button class="btn" type="button" @click="emit('close')">{{ editors.length ? 'Cancel' : 'Close' }}</button>
+        </div>
+      </form>
+    </template>
+    <div v-if="proposed" class="buttons">
+      <button class="btn primary" type="button" @click="emit('close')">Done</button>
+    </div>
+  </Modal>
+</template>
+
+<style scoped>
+.lead {
+  margin: 0;
+  color: var(--muted);
+}
+.form {
+  display: grid;
+  gap: 12px;
+}
+.buttons {
+  display: flex;
+  gap: 10px;
+}
+</style>
diff --git a/web/app/components/DeleteDocumentDialog.vue b/web/app/components/DeleteDocumentDialog.vue
